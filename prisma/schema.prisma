// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Profil Desa
model ProfilDesa {
  id          Int     @id @default(autoincrement())
  nama        String
  kepala      String
  alamat      String?
  kontak      String?
  deskripsi   String?
  captionUtama String @default("Desa Maju, Sejahtera & Bermartabat")
  subcaption   String @default("Portal digital resmi desa untuk informasi publik dan kegiatan masyarakat.")
  updatedAt   DateTime @updatedAt
}

// Berita
model Berita {
  id        Int     @id @default(autoincrement())
  judul     String
  ringkasan String
  isi       String?
  kategori  String  @default("Umum")
  emoji     String  @default("📰")
  bgColor   String  @default("#E8EDE9")
  tanggal   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pengumuman
model Pengumuman {
  id        Int     @id @default(autoincrement())
  judul     String
  isi       String
  pengirim  String
  status    String  @default("aktif")
  tanggal   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Statistik Desa
model StatistikDesa {
  id    Int     @id @default(autoincrement())
  label String  @unique
  nilai String
  updatedAt DateTime @updatedAt
}

model Galeri {
  id        Int      @id @default(autoincrement())
  judul     String
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Potensi Desa
model PotensiDesa {
  id        Int      @id @default(autoincrement())
  judul     String
  deskripsi String
  emoji     String   @default("🌟")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Admin User
model AdminUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  updatedAt DateTime @updatedAt
}

// Perangkat Desa (Struktur Organisasi)
model PerangkatDesa {
  id        Int      @id @default(autoincrement())
  nama      String
  jabatan   String
  foto      String?
  inisial   String?
  warnaBg   String   @default("#1D6A3A")
  urutan    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


