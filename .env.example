# ============================================================
# ENV VARIABLES — Desa Sukamaju
# Salin file ini menjadi .env.local dan isi nilainya
# ============================================================

# Database (Neon PostgreSQL / PlanetScale)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth (jika pakai next-auth untuk admin login)
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp API (opsional)
WA_API_TOKEN=""
WA_PHONE_NUMBER_ID=""

# Upload (opsional — Cloudinary / S3)
CLOUDINARY_URL=""
